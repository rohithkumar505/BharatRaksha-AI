{
  "name": "bharat-raksha-ai",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@bharat-raksha/web",
    "start:local": "bash scripts/start-dev.sh",
    "build": "npm run build --workspace=@bharat-raksha/web",
    "db:generate": "npm run generate --workspace=@bharat-raksha/database",
    "db:migrate": "npm run migrate --workspace=@bharat-raksha/database",
    "db:push": "npm run push --workspace=@bharat-raksha/database",
    "db:seed": "npm run seed --workspace=@bharat-raksha/database",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "ai:dev": "cd services/ai && python -m uvicorn main:app --reload --port 8001",
    "verify:sih26190": "npx tsx scripts/verify-sih26190-live.ts"
  },
  "description": "Bharat Raksha AI — MHA SIH26190 Secure Digital Document Management (Smart Automation)"
}
